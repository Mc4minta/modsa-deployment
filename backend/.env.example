# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored — never commit real API keys.

# ── RAG app · Chat / LLM (OpenAI-compatible) ──────────────────────────
# Local dev: point at local Ollama. Production: point at Ollama Cloud.
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="minimax-m3:cloud"
LLM_TIMEOUT="30"
LLM_MAX_RETRIES="2"
# Production example (Ollama Cloud):
# LLM_BASE_URL="https://ollama.com/v1"
# LLM_API_KEY="<your-ollama-cloud-key>"
# LLM_MODEL="minimax-m3:cloud"

# ── RAG app · Embeddings ────────────────────────────────────────────────
# EMBEDDING_PROVIDER switches the backend without touching code:
#   ollama      -> local Ollama (dev only, bge-m3 not reachable from Render)
#   huggingface -> Hugging Face Inference API (production — bge-m3 not
#                  offered by Ollama Cloud, this is the deploy target)
#   openai      -> any OpenAI-compatible embeddings endpoint
EMBEDDING_PROVIDER="ollama"
EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_API_KEY="ollama"
EMBEDDING_MODEL="bge-m3:latest"
EMBEDDING_TIMEOUT="30"
EMBEDDING_MAX_RETRIES="2"
# Production example (Hugging Face Inference API):
# EMBEDDING_PROVIDER="huggingface"
# EMBEDDING_API_KEY="<your-hf-access-token>"
# EMBEDDING_MODEL="BAAI/bge-m3"

# ── RAG storage & ingestion ───────────────────────────────────────────
CHROMA_DIR="chroma_db"
CHROMA_COLLECTION="modsa_kmutt"
# Local: use existing prepared chunks
RAG_SOURCE_PATHS="../data/chunks"
CHUNK_SIZE="1000"
CHUNK_OVERLAP="150"
RETRIEVAL_K="4"
# RETRIEVAL_MIN_RELEVANCE="0.35"

# ── API server ────────────────────────────────────────────────────────
APP_HOST="127.0.0.1"
APP_PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Required: POST /admin/reindex refuses to run (500) if this is unset.
ADMIN_API_KEY="change-me"

# ── DATA pipeline · Typhoon OCR (PDF scans only) ──────────────────────
TYPHOON_OCR_API_KEY="your-typhoon-ocr-key"
