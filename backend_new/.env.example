# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored — never commit real API keys.

# ── RAG app · Chat / LLM (OpenAI-compatible) ──────────────────────────
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="minimax-m3:cloud"

# ── RAG app · Embeddings (OpenAI-compatible) ──────────────────────────
EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_API_KEY="ollama"
EMBEDDING_MODEL="bge-m3:latest"

# ── RAG storage & ingestion ───────────────────────────────────────────
CHROMA_DIR="chroma_db"
CHROMA_COLLECTION="modsa_kmutt"
# Local: use existing prepared chunks from backend_old
RAG_SOURCE_PATHS="../backend_old/chunks"
CHUNK_SIZE="1000"
CHUNK_OVERLAP="150"
RETRIEVAL_K="4"
# RETRIEVAL_MIN_RELEVANCE="0.35"

# ── API server ────────────────────────────────────────────────────────
APP_HOST="127.0.0.1"
APP_PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Optional: when set, POST /admin/reindex requires header X-Admin-Key
# ADMIN_API_KEY="change-me"

# ── DATA pipeline · Typhoon OCR (PDF scans only) ──────────────────────
TYPHOON_OCR_API_KEY="your-typhoon-ocr-key"
