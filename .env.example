# ==============================================================================
# MOD-SA Single-VM Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit the .env file containing real API keys or tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Generation (OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# Base URL for the OpenAI-compatible chat completions API.
# Examples:
#   - OpenAI:       https://api.openai.com/v1
#   - Ollama Cloud: https://ollama.com/v1
#   - Local VM:     http://localhost:11434/v1
LLM_BASE_URL="https://api.openai.com/v1"

# API key for the LLM provider
LLM_API_KEY="your-llm-api-key-here"

# Model identifier
LLM_MODEL="gpt-4o-mini"

# Request timeout in seconds for LLM generation
LLM_TIMEOUT="30.0"

# Maximum retry attempts for failed LLM calls.
# RECOMMENDED FOR VM / CLOUDFLARE TUNNEL: LLM_MAX_RETRIES=1
# Justification: Cloudflare enforces an edge HTTP timeout of ~100 seconds.
# With LLM_TIMEOUT=30s:
#   At LLM_MAX_RETRIES=2: (30s x 3 attempts) + embedding time = 90s+ (can exceed 100s, causing 524 Cloudflare timeout).
#   At LLM_MAX_RETRIES=1: (30s x 2 attempts) + embedding time = ~65s (safely within Cloudflare's 100s limit).
LLM_MAX_RETRIES="1"

# ------------------------------------------------------------------------------
# 2. Embedding Configuration (Used for Chroma vector store retrieval and indexing)
# ------------------------------------------------------------------------------
# EMBEDDING_PROVIDER selects the provider: "openai", "huggingface", or "ollama"
#
# Option A: OpenAI-compatible embedding endpoint (default example)
EMBEDDING_PROVIDER="openai"
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY="your-embedding-api-key-here"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_TIMEOUT="30.0"
EMBEDDING_MAX_RETRIES="1"

# Option B: Hugging Face Inference API example (uncomment to use)
# Note: EMBEDDING_API_KEY must be a valid Hugging Face token with Inference API access.
# Startup will raise an error if EMBEDDING_API_KEY is missing when EMBEDDING_PROVIDER=huggingface.
# EMBEDDING_PROVIDER="huggingface"
# EMBEDDING_BASE_URL="https://api-inference.huggingface.co"
# EMBEDDING_API_KEY="hf_your_hugging_face_token_here"
# EMBEDDING_MODEL="BAAI/bge-m3"
# EMBEDDING_TIMEOUT="30.0"
# EMBEDDING_MAX_RETRIES="1"

# Option C: Ollama embedding example (uncomment to use)
# EMBEDDING_PROVIDER="ollama"
# EMBEDDING_BASE_URL="http://localhost:11434/v1"
# EMBEDDING_API_KEY="ollama"
# EMBEDDING_MODEL="bge-m3:latest"
# EMBEDDING_TIMEOUT="30.0"
# EMBEDDING_MAX_RETRIES="1"

# ------------------------------------------------------------------------------
# 3. ChromaDB & Document Ingestion
# ------------------------------------------------------------------------------
# Path inside the backend container for persistent Chroma storage.
# Mapped via docker-compose to ./data/chroma on the host VM.
CHROMA_DIR="/app/chroma_db"

# Chroma collection identifier
CHROMA_COLLECTION="modsa_kmutt"

# Path inside backend container where pre-chunked JSON documents are baked in.
# Default image bakes chunks at /app/data/chunks.
RAG_SOURCE_PATHS="/app/data/chunks"

# Character chunking settings (used only if non-JSON source files are ingested)
CHUNK_SIZE="1000"
CHUNK_OVERLAP="150"

# Retrieval depth: number of chunk passages retrieved per user query
RETRIEVAL_K="4"

# ------------------------------------------------------------------------------
# 4. Security & Administrative Controls
# ------------------------------------------------------------------------------
# REQUIRED: High-entropy secret key protecting POST /admin/reindex.
# Reindexing triggers complete vector re-embedding from scratch via external API.
# This endpoint is NOT exposed publicly through Nginx; it is triggered exclusively
# via scripts/reindex.sh from inside the container network.
ADMIN_API_KEY="generate-a-strong-random-secret-here"

# Cloudflare Named Tunnel token (required only when running with --profile named)
# Generate from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels.
# Leave blank when using Quick Tunnels (--profile quick).
TUNNEL_TOKEN=""

# CORS Allowed Origins
# Note: For the VM deployment, frontend and backend share the same origin via Nginx
# reverse proxy (/ and /api/*), so CORS preflight checks are bypassed entirely.
# This setting is preserved for cross-origin setups (e.g. Vercel frontend to Render backend).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
